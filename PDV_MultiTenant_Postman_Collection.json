				{
					"name": "3.2 Finalizar com TEF (Crédito)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('TEF autorizado', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    if (jsonData.tef_transaction) {",
									"        pm.expect(jsonData.tef_transaction.status).to.eql('confirmed');",
									"        console.log('NSU:', jsonData.tef_transaction.nsu);",
									"        console.log('Autorização:', jsonData.tef_transaction.authorization_code);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"payment_type\": \"credit\",\n  \"total\": 150.00,\n  \"installments\": 3,\n  \"card_data\": {\n    \"number\": \"4111111111111111\",\n    \"holder\": \"JOSE SILVA\",\n    \"expiry\": \"12/2030\",\n    \"cvv\": \"123\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/pos/{{sale_id_tef}}/finalize",
							"host": ["{{base_url}}"],
							"path": ["api", "pos", "{{sale_id_tef}}", "finalize"]
						}
					}
				}
