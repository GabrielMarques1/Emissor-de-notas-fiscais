{
	"info": {
		"name": "PDV Multi-Tenant - Testes Completos",
		"description": "Collection completa para testar TEF, PIX, Multi-Payment, Suspensão, Descontos e Devoluções",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autenticação",
			"item": [
				{
					"name": "Login PDV",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Salvar cookie de sessão",
									"if (pm.response.headers.get('Set-Cookie')) {",
									"    pm.environment.set('session_cookie', pm.response.headers.get('Set-Cookie'));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"usuario\": \"admin\",\n  \"senha\": \"sua_senha_aqui\",\n  \"id_empresa\": 100\n}"
						},
						"url": {
							"raw": "{{base_url}}/pdv/login",
							"host": ["{{base_url}}"],
							"path": ["pdv", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. PIX - Teste Completo",
			"item": [
				{
					"name": "2.1 Criar Venda",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.environment.set('sale_id', jsonData.id_pos_sale);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    {\n      \"id_produto\": 999,\n      \"quantity\": 2,\n      \"unit_price\": 50.00\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/pos",
							"host": ["{{base_url}}"],
							"path": ["api", "pos"]
						}
					}
				},
				{
					"name": "2.2 Finalizar com PIX",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('PIX QR Code gerado', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.pix).to.exist;",
									"    pm.expect(jsonData.pix.qr_code).to.exist;",
									"    pm.expect(jsonData.pix.txid).to.exist;",
									"    console.log('TXID:', jsonData.pix.txid);",
									"    console.log('QR Code:', jsonData.pix.qr_code);",
									"    pm.environment.set('pix_txid', jsonData.pix.txid);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"payment_type\": \"pix\",\n  \"total\": 100.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/pos/{{sale_id}}/finalize",
							"host": ["{{base_url}}"],
							"path": ["api", "pos", "{{sale_id}}", "finalize"]
						}
					}
				},
				{
					"name": "2.3 Simular Webhook PIX (Confirmar Pagamento)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"txid\": \"{{pix_txid}}\",\n  \"e2e_id\": \"E12345678202510021234567890AB\",\n  \"status\": \"paid\",\n  \"amount\": 100.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/pix/webhook/100",
							"host": ["{{base_url}}"],
							"path": ["api", "pix", "webhook", "100"]
						}
					}
				}
			]
		},
